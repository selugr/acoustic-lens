		"start": "node dist/index.js"
	},
	"dependencies": {
		"@elevenlabs/elevenlabs-js": "^2.56.0",
		"express": "^5.2.1",
		"groq-sdk": "^1.3.0"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^26.1.0",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^5.0.1",
		"supertest": "^7.2.2",
		"tsup": "^8.5.1",
		"tsx": "^4.22.5",
		"vitest": "^5.0.1"
	}
}
