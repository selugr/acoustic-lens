	"description": "",
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"dev": "tsx --env-file .env --watch-path=./src src/index.ts",
		"debug": "node --inspect -r tsx --env-file .env src/index.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"build": "tsup",
