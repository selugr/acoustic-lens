{
	"services": {
		"frontend": {
			"root": "frontend",
			"framework": "vite"
		},
		"backend": {
			"root": "backend",
			"framework": "express",
			"buildCommand": "pnpm run build",
			"entrypoint": "dist/index.cjs"
		}
	},
	"rewrites": [
		{
			"source": "/api(/.*)?",
			"destination": {
				"type": "service",
				"service": "backend"
			}
		},
		{
			"source": "/(.*)",
			"destination": {
				"type": "service",
				"service": "frontend"
			}
		}
	]
}
